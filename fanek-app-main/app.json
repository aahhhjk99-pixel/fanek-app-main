{
  "expo": {
    "name": "Fanek",
    "slug": "fanek-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fanek-app",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "السماح لتطبيق فانيك باستخدام موقعك أثناء استخدام التطبيق"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/fanek-app-main"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "246c77d4-7d1a-4289-89ef-a3793e79d81c"
      }
    },
    "android": {
      "package": "com.ahhhhhfwhbdhebzb67266.fanekapp"
    }
  }
}
